# Database — local embedded (no Docker)
DATABASE_URL=pglite://.local/titan-journal

# Production: Neon Postgres
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

PORT=8080
APP_URL=http://localhost:18405

# Supabase Auth (https://supabase.com/dashboard → Project Settings → API)
# Use the anon/public key (eyJ...) or publishable key (sb_publishable_...)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Local dev: Authentication → Providers → Email ON; optional: disable "Confirm email" for instant sign-in

# Optional: seed demo trades for a signed-up user (Supabase → Authentication → Users → UUID)
# SEED_USER_ID=

# PayFast — recommended for South Africa (see DEPLOY-SA.md)
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_SANDBOX=true
# PAYFAST_AMOUNT_ZAR=149.00
# API_PUBLIC_URL=https://your-api.example.com

# Stripe (optional — not available in most of SA)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# OpenAI (optional — Pro users only)
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
